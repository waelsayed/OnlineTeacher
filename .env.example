POSTGRES_DB=onlineteacher
POSTGRES_USER=onlineteacher
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# The API builds its connection string from the POSTGRES_* vars above, or honours an
# explicit full connection string when present (takes precedence).
ConnectionStrings__DefaultConnection=

# JWT configuration. Never commit a real signing key.
Jwt__Issuer=OnlineTeacher.Central
Jwt__Audience=OnlineTeacher.Teachers
Jwt__SigningKey=change-me-to-a-long-random-secret
Jwt__TokenLifetimeMinutes=120